// LearnNova Prisma schema
// Provider is SQLite for zero-config local dev — swap to postgresql/mysql by changing
// `provider` and `DATABASE_URL` in .env, then re-run `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Catalog (subject-matter content, shared across users) ────────────────────

model Course {
  id           String   @id
  title        String
  subject      String
  level        String
  description  String
  totalLessons Int
  duration     String
  instructor   String
  image        String
  color        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lessons  Lesson[]
  progress UserCourseProgress[]
}

model Lesson {
  id        String   @id
  courseId  String
  title     String
  duration  String
  order     Int
  content   String
  keyPoints Json
  examples  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress UserLessonProgress[]

  @@index([courseId, order])
}

model Quiz {
  id        String   @id
  title     String
  subject   String
  timeLimit Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id           String @id
  quizId       String
  order        Int
  question     String
  options      Json
  correctIndex Int
  explanation  String

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
}

model Skill {
  id          String @id
  name        String
  description String
  difficulty  String
  exercises   Int
  icon        String
  color       String

  progress UserSkillProgress[]
}

model Achievement {
  id          String @id
  title       String
  description String
  icon        String
  color       String

  earnedBy UserAchievement[]
}

model Testimonial {
  id      String @id
  name    String
  role    String
  content String
  avatar  String
  rating  Int
}

// ─── User & per-user state ────────────────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  role             String   @default("STUDENT") // STUDENT | ADMIN
  grade            String
  learningGoals    Json
  favoriteSubjects Json
  streak           Int      @default(0)
  dailyGoal        Int      @default(60)
  avatar           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courseProgress UserCourseProgress[]
  lessonProgress UserLessonProgress[]
  skillProgress  UserSkillProgress[]
  achievements   UserAchievement[]
  aiMessages     AIMessage[]
  quizAttempts   QuizAttempt[]
  studySessions  StudySession[]
  wordReports    WordReport[]
}

model GlobalWordOverride {
  wordId    String   @id // e.g. "topik-435" or "eps-12"
  korean    String?
  english   String?
  khmer     String?
  createdBy String   // admin user id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalDialogueLineOverride {
  dialogueId String
  lineIndex  Int
  korean     String?
  english    String?
  khmer      String?
  createdBy  String   // admin user id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([dialogueId, lineIndex])
}

model GlobalGrammarOverride {
  grammarId       String   @id // e.g. "topik-grammar-1" or "eps-grammar-12"
  korean          String?  // pattern
  english         String?  // meaning
  patternKhmer    String?
  exampleKorean   String?
  exampleEnglish  String?
  exampleKhmer    String?
  createdBy       String   // admin user id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WordReport {
  id              String   @id @default(cuid())
  userId          String
  wordId          String   // e.g. "topik-435" or "eps-12"
  wordKorean      String
  wordEnglish     String
  wordKhmer       String
  suggestedKorean String?
  suggestedEnglish String?
  suggestedKhmer  String?
  reason          String   @default("")
  status          String   @default("PENDING") // PENDING | RESOLVED | REJECTED
  adminNote       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resolvedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model UserCourseProgress {
  id               String   @id @default(cuid())
  userId           String
  courseId         String
  progress         Int      @default(0)
  completedLessons Int      @default(0)
  updatedAt        DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model UserLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model UserSkillProgress {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model AIMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

model StudySession {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime
  minutes  Int
  quizzes  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
